<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <ImageView
        android:id="@+id/ivDetalleImagen"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_gallery" />

    <TextView
        android:id="@+id/tvDetalleDireccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dirección: "
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDetalleValor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Valor: "
        android:textSize="18sp"
        android:textColor="#3F51B5"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDetalleAmbientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ambientes: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDetalleSuperficie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Superficie: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDetalleUso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Uso: "
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvDetalleTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo: "
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDetalleEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado: "
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Switch
            android:id="@+id/swDetalleEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp" />
    </LinearLayout>

</LinearLayout>